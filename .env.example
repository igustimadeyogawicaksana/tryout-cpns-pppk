DATABASE_PATH=./data/app.sqlite
BODY_SIZE_LIMIT=4M
ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
# Generate a random secret of at least 32 characters; never commit the real .env.
BETTER_AUTH_SECRET=
# Optional: activate Google only after configuring its OAuth app and callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional upload API. Generate with npm run api:token -- email-admin.
# Store only the SHA-256 digest here; the bearer token stays with the client.
QUESTIONS_API_TOKEN_SHA256=
QUESTIONS_API_USER_ID=
# Required for email registration/recovery in production. Development writes .local/mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
